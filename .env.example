# Copy this file to ".env" (in the folder you run the app from) and fill in your keys.
# The real .env file is ignored by git, so your keys stay on your computer.

# Used by Data_Analyst_Agents_2
GOOGLE_API_KEY=your-new-google-key-here
TAVILY_API_KEY=your-new-tavily-key-here
NVIDIA_API_KEY=your-nvidia-key-here

# Used by mixture_of_experts and Automated_Tiktok_Trending_Analysis
GEMINI_API_KEY=your-new-google-key-here
